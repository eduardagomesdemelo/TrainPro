{
  "expo": {
    "name": "TrainPRO",
    "slug": "trainpro",
    "scheme": "trainpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0D11",
    "android": {
      "package": "com.trainpro.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}