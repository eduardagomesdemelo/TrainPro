{
  "expo": {
    "name": "TrainPRO",
    "slug": "trainpro",
    "scheme": "trainpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0D11",
    "android": {
      "package": "com.trainpro.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TrainPRO acessa suas fotos para você escolher a foto de perfil.",
          "cameraPermission": "O TrainPRO usa a câmera para você tirar a foto de perfil."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
